# PostgreSQL connection string (e.g. a free Neon database).
# Leave empty to run in in-memory demo mode (data resets on restart).
DATABASE_URL=

# Public base URL for metadata (optional; Vercel sets VERCEL_URL automatically).
NEXT_PUBLIC_SITE_URL=

# Optional: self-hosted / alternate code-execution backend.
# Defaults to the free public Wandbox API (https://wandbox.org).
EXEC_API_URL=
